# 复制到 backend/.env 后生效（backend/.env 不入库）
# LLM_PROVIDER=fake | openai_compat
LLM_PROVIDER=fake
# 通义千问 DashScope compatible-mode: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# DB 层：缺省会走 config.py 的 mysql:3306，而宿主 3306 是非本项目的原生 mysqld（S2 复审更正）
# —— 裸跑 uvicorn / seed_academic.py 前必须有这两行，否则会去别人的库上建表。
# 容器实际发布在 3307；要连真库把 DB_BACKEND 改成 mysql。
DB_BACKEND=sqlite
MYSQL_PORT=3307
# DB_BACKEND=mysql 时必填（config 默认 root+空密码，对 deploy compose 容器会 1045）：
# 填 deploy/.env 的 MYSQL_ROOT_PASSWORD。backend 与其拉起的 academic MCP 子进程
# 共用这组凭据（_academic_env 透传），迁移 DDL 需要 root——agent_ro 只给 run_sql
# 纵深场景手工验证用，不进 backend/.env。
MYSQL_USER=root
MYSQL_PASSWORD=
